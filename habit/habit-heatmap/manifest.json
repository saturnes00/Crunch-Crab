{
  "manifest_version": 2,
  "name": "Habit Heatmap",
  "version": "2.1.0",
  "description": "Suis jusqu’à 3 habitudes avec un calendrier façon GitHub, rangé dans un onglet discret sur le bord droit de chaque page.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": ["storage", "activeTab"],
  "browser_action": {
    "default_icon": "icons/icon.svg",
    "default_title": "Habit Heatmap",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "habit-heatmap@saynt.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
